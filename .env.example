
# Puerto HTTP de la API (por defecto 3000)
PORT=3000

# Nombre mostrado en Swagger/OpenAPI (por defecto StyleNow API)
APP_NAME="StyleNow API"

# Version mostrada en Swagger/OpenAPI (por defecto 0.3.0)
APP_VERSION=0.3.0

# Ruta relativa de Swagger, sin slash inicial (por defecto api)
SWAGGER_PATH=api

# MySQL es obligatorio. Definir todos los campos para una base autorizada.
# No hay selector de persistencia ni credenciales predeterminadas.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Obligatorio: secreto HMAC del JWT, minimo 32 bytes y no solo espacios.
# Generarlo por entorno (p. ej. 64 caracteres hex aleatorios); nunca versionarlo.
JWT_SECRET=
# Vigencia del token en segundos (60 a 86400). Por defecto 3600.
JWT_EXPIRACION_SEGUNDOS=3600

# P4: IDs de personal autorizado para operar envios; vacio deniega a todos.
LOGISTICA_OPERADORES_IDS=

# P5: directorio de imagenes. En Docker usa el volumen /app/uploads.
IMAGENES_DIRECTORIO=uploads/productos

# P6: origenes del frontend autorizados por CORS, exactos y separados por coma
# (esquema://host[:puerto], sin ruta, sin barra final y sin *). Ejemplo:
# CORS_ORIGENES=https://app.stylenow.cl,http://localhost:5173
# Vacio: fuera de produccion se admiten http://localhost:5173, :4173 y sus
# equivalentes 127.0.0.1 (Vite); con NODE_ENV=production (imagen Docker) no se
# admite ningun origen cruzado hasta definirla. Sin credenciales/cookies: JWT Bearer.
CORS_ORIGENES=
